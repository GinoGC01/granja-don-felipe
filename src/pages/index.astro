---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Granja Don Felipe - Huevos Frescos y Visitas Educativas en Jujuy">
  
  <!-- Hero Section -->
  <section class="relative bg-cream-100 overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center min-h-[calc(100vh-5rem)] py-16 lg:py-0">
        
        <!-- Left Content -->
        <div class="space-y-8 lg:pr-8">
          <div class="inline-block">
            <span class="inline-flex items-center px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Producción 100% Agroecológica
            </span>
          </div>

          <h1 class="font-serif text-5xl lg:text-6xl xl:text-7xl font-bold text-gray-900 leading-tight">
            Huevos Frescos y Experiencias que Conectan
          </h1>

          <p class="text-xl text-gray-600 leading-relaxed">
            Granja agroecológica familiar en San Salvador de Jujuy. Producimos huevos y pollos de forma natural, sin químicos ni intermediarios. También ofrecemos visitas guiadas para que familias y escuelas aprendan de dónde vienen los alimentos.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="https://wa.me/5493884000000?text=Hola!%20Quisiera%20consultar%20por%20productos%20de%20la%20granja" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-xl hover:scale-105 text-lg"
            >
              <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Pedí Huevos Frescos
            </a>
            <a 
              href="#visitas"
              class="inline-flex items-center justify-center px-8 py-4 bg-white border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:border-green-600 hover:text-green-600 transition-all duration-300 text-lg"
            >
              Conocé la Granja
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-8 pt-8 border-t border-gray-200">
            <div>
              <div class="font-serif text-4xl font-bold text-green-600"  data-counter="100">0</div>
              <div class="text-sm text-gray-600 mt-1">Agroecológico</div>
            </div>
            <div>
              <div class="font-serif text-4xl font-bold text-green-600"  data-counter="200">0</div>
              <div class="text-sm text-gray-600 mt-1">Visitas mensuales</div>
            </div>
            <div>
              <div class="font-serif text-4xl font-bold text-green-600"  data-counter="7">0</div>
              <div class="text-sm text-gray-600 mt-1">Años Activos</div>
            </div>
          </div>
        </div>

        <!-- Right Image -->
        <div class="relative lg:h-[600px]">
          <div class="absolute inset-0 bg-green-600 rounded-3xl transform rotate-3"></div>
          <div class="relative h-full rounded-3xl overflow-hidden shadow-2xl">
            <img 
              src="https://images.unsplash.com/photo-1548550023-2bdb3c5beed7?w=800&h=1000&fit=crop" 
              alt="Gallinas felices en Granja Don Felipe"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Floating Badge -->
          <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-xl p-6 max-w-xs">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Frescura Diaria</p>
                <p class="text-sm text-gray-600">Recolectados cada mañana</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          ¿Por Qué Elegirnos?
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Trabajamos con amor y respeto por la naturaleza para ofrecerte productos de verdadera calidad
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        <!-- Value 1 -->
        <div class="group text-center">
          <div class="w-20 h-20 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-green-600 transition-all duration-300 group-hover:scale-110">
            <svg class="w-10 h-10 text-green-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-gray-900 mb-4">Producción Agroecológica</h3>
          <p class="text-gray-600 leading-relaxed">
            Nuestras gallinas viven libres, se alimentan naturalmente y producen huevos de verdad. Sin hormonas, sin antibióticos, sin apuro.
          </p>
        </div>

        <!-- Value 2 -->
        <div class="group text-center">
          <div class="w-20 h-20 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-green-600 transition-all duration-300 group-hover:scale-110">
            <svg class="w-10 h-10 text-green-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-gray-900 mb-4">Educación que Nutre</h3>
          <p class="text-gray-600 leading-relaxed">
            Abrimos las puertas de la granja para que familias y escuelas descubran cómo se producen los alimentos de forma responsable y sustentable.
          </p>
        </div>

        <!-- Value 3 -->
        <div class="group text-center">
          <div class="w-20 h-20 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-green-600 transition-all duration-300 group-hover:scale-110">
            <svg class="w-10 h-10 text-green-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-gray-900 mb-4">Compromiso Familiar</h3>
          <p class="text-gray-600 leading-relaxed">
            Somos una familia de productores locales que trabaja con amor y respeto por la tierra. Cada huevo lleva nuestro nombre.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Preview -->
  <section id="productos" class="py-20 lg:py-32 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-4">
          Nuestros Productos
        </span>
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Del Campo a Tu Mesa
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Producción limitada, calidad ilimitada. Todo fresco, sin químicos, directo de la granja a tu casa.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Product Card 1 -->
        <div class="group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://tse1.explicit.bing.net/th/id/OIP.A3OFgouiiB8UTe_AWF4NkQHaE8?cb=ucfimg2&ucfimg=1&rs=1&pid=ImgDetMain&o=7&rm=3" 
              alt="Huevos agroecológicos"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute top-4 left-4 bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium">
              Más Vendido
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">Huevos Agroecológicos</h3>
            <p class="text-gray-600 mb-4">
              De gallinas Isa Brown criadas en libertad. Yema naranja intensa, sabor incomparable.
            </p>
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm text-gray-500">Media docena / Docena / Maple</span>
            </div>
            <a 
              href="https://wa.me/5493884000000?text=Hola!%20Me%20interesan%20los%20huevos%20agroecológicos" 
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors"
            >
              Consultar Disponibilidad
            </a>
          </div>
        </div>

        <!-- Product Card 2 -->
        <div class="group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1587593810167-a84920ea0781?w=600&h=400&fit=crop" 
              alt="Pollos de campo"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
          </div>
          <div class="p-6">
            <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">Pollos de Campo</h3>
            <p class="text-gray-600 mb-4">
              Criados libres, sin antibióticos. Carne sabrosa y saludable para tu familia.
            </p>
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm text-gray-500">Enteros o por corte</span>
            </div>
            <a 
              href="https://wa.me/5493884000000?text=Hola!%20Me%20interesan%20los%20pollos%20de%20campo" 
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors"
            >
              Consultar Disponibilidad
            </a>
          </div>
        </div>

        <!-- Product Card 3 -->
        <div class="group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1516876437184-593fda40c7ce?w=600&h=400&fit=crop" 
              alt="Gallinas ponedoras"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
          </div>
          <div class="p-6">
            <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">Gallinas Ponedoras</h3>
            <p class="text-gray-600 mb-4">
              Para tu propia producción casera. Pollitas y adultas disponibles.
            </p>
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm text-gray-500">Diferentes edades</span>
            </div>
            <a 
              href="https://wa.me/5493884000000?text=Hola!%20Me%20interesan%20las%20gallinas%20ponedoras" 
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors"
            >
              Consultar Disponibilidad
            </a>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a 
          href="/productos" 
          class="inline-flex items-center text-green-600 font-semibold hover:text-green-700 transition-colors text-lg"
        >
          Ver Catálogo Completo
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Visits Section -->
  <section id="visitas" class="py-20 lg:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Image -->
        <div class="order-2 lg:order-1">
          <div class="relative">
            <div class="absolute -inset-4 bg-green-100 rounded-3xl transform -rotate-3"></div>
            <div class="relative rounded-3xl overflow-hidden shadow-2xl">
              <img 
                src="https://images.unsplash.com/photo-1560493676-04071c5f467b?w=800&h=600&fit=crop" 
                alt="Niños en visita educativa"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Right Content -->
        <div class="order-1 lg:order-2 space-y-6">
          <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium">
            Experiencias Educativas
          </span>
          
          <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900">
            Un Día en la Granja que Recordarán Siempre
          </h2>
          
          <p class="text-xl text-gray-600 leading-relaxed">
            Traé a tus hijos a vivir una experiencia única. En Don Felipe pueden alimentar gallinas, recolectar huevos, caminar por la huerta y entender de dónde vienen los alimentos.
          </p>

          <div class="space-y-4">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Contacto Directo con Animales</h4>
                <p class="text-gray-600">Alimentá gallinas, recolectá huevos frescos y conocé la rutina diaria de la granja</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Aprendizaje Vivencial</h4>
                <p class="text-gray-600">Educación ambiental práctica sobre producción sustentable y bienestar animal</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Ideal para Familias y Escuelas</h4>
                <p class="text-gray-600">Grupos familiares y visitas pedagógicas personalizadas con guías especializados</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a 
              href="https://wa.me/5493884000000?text=Hola!%20Me%20gustaría%20agendar%20una%20visita%20a%20la%20granja" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-xl"
            >
              Reservar Visita
            </a>
            <a 
              href="/visitas"
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-gray-300 text-gray-700 font-semibold rounded-lg hover:border-green-600 hover:text-green-600 transition-all duration-300"
            >
              Más Información
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-20 lg:py-32 bg-green-600 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 bg-white/20 text-white rounded-full text-sm font-medium mb-6">
          Nuestra Historia
        </span>
        
        <h2 class="font-serif text-4xl lg:text-5xl font-bold mb-6">
          Una Granja Familiar con Propósito
        </h2>
        
        <p class="text-xl text-green-50 leading-relaxed mb-8">
          En 2018, Don Felipe y su familia decidieron dar un giro a su producción. Dejaron atrás los métodos intensivos y apostaron por algo distinto: criar gallinas felices, producir alimentos limpios y abrir las puertas de la granja para que otros aprendieran junto a ellos.
        </p>

        <p class="text-lg text-green-50 leading-relaxed mb-12">
          Hoy somos más que una granja. Somos una familia que cree que cada persona tiene derecho a saber de dónde viene su comida. Trabajamos con principios agroecológicos, respetamos los ritmos de la naturaleza y el bienestar de nuestros animales. Porque estamos convencidos de que la calidad no se negocia.
        </p>

        <a 
          href="/nosotros"
          class="inline-flex items-center px-8 py-4 bg-white text-green-600 font-semibold rounded-lg hover:bg-green-50 transition-all duration-300"
        >
          Conocé Nuestra Historia
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 lg:py-32 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-4">
          Testimonios
