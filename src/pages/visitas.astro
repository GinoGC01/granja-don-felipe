---
// src/pages/visitas.astro
import Star from '../icons/Star.astro';
import Layout from '../layouts/Layout.astro';

// Visit types
const visitTypes = [
  {
    id: 'familiar',
    name: 'Visita Familiar',
    icon: 'family',
    duration: '2 horas',
    price: 2500,
    groupSize: '2-8 personas',
    description: 'Experiencia completa para familias que quieren reconectarse con la naturaleza y aprender sobre producción agroecológica.',
    includes: [
      'Recorrido guiado por toda la granja',
      'Alimentación de gallinas',
      'Recolección de huevos frescos',
      'Visita a la huerta orgánica',
      'Charla sobre bienestar animal',
      'Merienda con productos de la granja'
    ],
    ideal: 'Familias con niños, grupos de amigos',
    featured: true
  },
  {
    id: 'escolar',
    name: 'Visita Escolar',
    icon: 'school',
    duration: '3 horas',
    price: 1800,
    groupSize: '15-40 alumnos',
    description: 'Salida pedagógica diseñada para que los estudiantes aprendan sobre alimentación sustentable, ciclos naturales y cuidado del ambiente.',
    includes: [
      'Recorrido educativo adaptado por edad',
      'Actividades prácticas con animales',
      'Taller sobre el ciclo del huevo',
      'Material didáctico para docentes',
      'Espacio de juegos y picnic',
      'Certificado de participación'
    ],
    ideal: 'Escuelas primarias y secundarias',
    featured: false
  },
  {
    id: 'cumpleaños',
    name: 'Cumpleaños en la Granja',
    icon: 'birthday',
    duration: '3 horas',
    price: 8500,
    groupSize: 'Hasta 15 niños',
    description: 'Celebrá un cumpleaños diferente rodeado de naturaleza. Incluye actividades, decoración temática y merienda especial.',
    includes: [
      'Decoración temática de granja',
      'Actividades guiadas con animales',
      'Juegos al aire libre',
      'Merienda completa (torta, sándwiches, jugos)',
      'Regalito sorpresa para cada niño',
      'Área exclusiva para la celebración'
    ],
    ideal: 'Cumpleaños de 4 a 12 años',
    featured: false
  },
  {
    id: 'privada',
    name: 'Visita Privada',
    icon: 'private',
    duration: 'Flexible',
    price: 0,
    priceText: 'Consultar',
    groupSize: 'A medida',
    description: 'Diseñamos una experiencia personalizada según tus intereses: fotografía, aprendizaje técnico, eventos corporativos o lo que necesites.',
    includes: [
      'Recorrido personalizado',
      'Horario flexible',
      'Enfoque según interés (técnico, recreativo, fotográfico)',
      'Atención exclusiva',
      'Posibilidad de catering especial',
      'Acceso a zonas restringidas'
    ],
    ideal: 'Eventos especiales, grupos corporativos, fotógrafos',
    featured: false
  }
];

// Activities
const activities = [
  {
    title: 'Alimentar las Gallinas',
    description: 'Los más chicos pueden darles de comer directamente de sus manos. Una experiencia única de contacto con los animales.',
    icon: 'feed',
    image: 'https://images.unsplash.com/photo-1548550023-2bdb3c5beed7?w=600&h=400&fit=crop'
  },
  {
    title: 'Recolectar Huevos',
    description: 'Entrá a los nidos y descubrí cómo las gallinas ponen sus huevos. Te llevás algunos a casa!',
    icon: 'eggs',
    image: 'https://media.istockphoto.com/id/1375676868/es/foto/huevos-de-gallina-frescos-en-una-canasta-de-mimbre-que-una-ni%C3%B1a-agricultora-latina-recolecta.jpg?b=1&s=170667a&w=0&k=20&c=-1YPETvmiVUK9_ue5Jp52SokB-8zR9Ww6zD0ln2Uo2M='
  },
  {
    title: 'Huerta Agroecológica',
    description: 'Conocé nuestra huerta y aprendé cómo cultivamos sin químicos. Según la temporada, podés cosechar tus propias verduras.',
    icon: 'garden',
    image: 'https://images.unsplash.com/photo-1523348837708-15d4a09cfac2?w=600&h=400&fit=crop'
  },
  {
    title: 'Charla Educativa',
    description: 'Aprendé sobre bienestar animal, producción sustentable y de dónde viene realmente tu comida.',
    icon: 'learn',
    image: 'https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=600&h=400&fit=crop'
  }
];

// Schedule
const schedule = [
  { day: 'Lunes a Viernes', hours: '9:00 - 17:00', note: 'Ideal para escuelas' },
  { day: 'Sábados', hours: '10:00 - 18:00', note: 'Turnos cada 2 horas' },
  { day: 'Domingos', hours: '10:00 - 16:00', note: 'Solo con reserva previa' }
];

// FAQ
const faqs = [
  {
    question: '¿Es necesario reservar con anticipación?',
    answer: 'Sí, todas las visitas requieren reserva previa. Te recomendamos reservar con al menos 7 días de anticipación, especialmente para fines de semana y feriados. Para escuelas, lo ideal es coordinar con 15-20 días de antelación.'
  },
  {
    question: '¿Qué pasa si llueve?',
    answer: 'Tenemos áreas cubiertas donde podemos realizar la mayoría de las actividades. En caso de lluvia intensa, podemos reprogramar sin cargo o hacer un recorrido adaptado bajo techo.'
  },
  {
    question: '¿Los niños pueden tocar los animales?',
    answer: 'Sí! El contacto supervisado con los animales es parte fundamental de la experiencia. Siempre con guía presente y siguiendo normas de higiene y seguridad. Los niños aprenden a respetar y cuidar a los animales.'
  },
  {
    question: '¿Qué debo llevar?',
    answer: 'Ropa cómoda y calzado cerrado (zapatillas o botas). Gorra o sombrero para el sol, protector solar y agua. Si vienen en verano, pueden traer repelente. Para picnic, pueden traer manta o reposera.'
  },
  {
    question: '¿Hay baños y zona de sombra?',
    answer: 'Sí, contamos con baños limpios y múltiples áreas con sombra natural. También tenemos gazebos para descansar y hacer picnic.'
  },
  {
    question: '¿Aceptan tarjeta de crédito?',
    answer: 'Aceptamos efectivo, transferencia bancaria y Mercado Pago. Para grupos grandes, podemos coordinar facturación.'
  },
  {
    question: '¿Puedo llevar mi propia comida?',
    answer: 'Sí, pueden traer merienda o almuerzo para hacer picnic. Tenemos mesas y parrillas disponibles. Solo pedimos que se lleven sus residuos o los dispongan en nuestros cestos de reciclaje.'
  },
  {
    question: '¿Desde qué edad pueden venir los niños?',
    answer: 'No hay edad mínima, pero la experiencia está más orientada a niños desde los 3 años en adelante. Los bebés y niños pequeños son bienvenidos, pero deben estar siempre con sus padres.'
  }
];

// Testimonials
const testimonials = [
  {
    name: 'Ana Martínez',
    role: 'Mamá de 2 niños',
    rating: 5,
    text: 'Mis hijos no pararon de hablar de la visita durante semanas. Ver sus caritas al recolectar los huevos no tiene precio. Super recomendable!',
    image: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop'
  },
  {
    name: 'Profesora Laura González',
    role: 'Escuela Primaria N°12',
    rating: 5,
    text: 'Llevamos a 4to grado y fue una experiencia increíble. Los guías adaptaron todo perfectamente a la edad de los chicos. Volvemos seguro!',
    image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=100&h=100&fit=crop'
  },
  {
    name: 'Carlos Romero',
    role: 'Padre',
    rating: 5,
    text: 'Hicimos el cumpleaños de mi hija de 7 años acá y fue un éxito total. Todos los padres quedaron encantados. Algo diferente y educativo a la vez.',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&fit=crop'
  }
];
---

<Layout 
  title="Visitá la Granja - Experiencias Educativas en Jujuy | Granja Don Felipe"
  description="Visitas guiadas para familias y escuelas en San Salvador de Jujuy. Aprendé sobre producción agroecológica, alimentá gallinas y recolectá huevos frescos. ¡Reservá ahora!"
>
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-green-600 to-green-700 text-white py-20 lg:py-32 overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <span class="inline-block px-4 py-2 bg-white/20 text-white rounded-full text-sm font-medium mb-6">
          Experiencias Educativas
        </span>
        <h1 class="font-serif text-5xl lg:text-6xl xl:text-7xl font-bold mb-6 leading-tight">
          Un Día en la Granja que Recordarán Siempre
        </h1>
        <p class="text-xl lg:text-2xl text-green-50 leading-relaxed mb-8">
          Traé a tu familia, tus alumnos o tu grupo a vivir una experiencia única. Aprendé, jugá y reconectate con la naturaleza.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#tipos-visita"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-green-600 font-semibold rounded-lg hover:bg-green-50 transition-all duration-300 hover:shadow-xl text-lg"
          >
            Ver Tipos de Visita
          </a>
          <a 
            href="https://wa.me/5493884000000?text=Hola!%20Me%20gustaría%20agendar%20una%20visita%20a%20la%20granja"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-green-600 transition-all duration-300 text-lg"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Reservar Ahora
          </a>
        </div>
      </div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute top-0 left-0 w-full h-full opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0,0 Q50,20 100,0 L100,100 L0,100 Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Activities Preview -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          ¿Qué Vas a Vivir en la Granja?
        </h2>
        <p class="text-xl text-gray-600">
          Experiencias prácticas que conectan a chicos y grandes con la naturaleza
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {activities.map((activity) => (
          <div class="group bg-cream-50 rounded-3xl overflow-hidden hover:shadow-xl transition-all duration-300">
            <div class="relative h-64 overflow-hidden">
              <img 
                src={activity.image} 
                alt={activity.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            </div>
            <div class="p-8">
              <h3 class="font-serif text-2xl font-bold text-gray-900 mb-3">
                {activity.title}
              </h3>
              <p class="text-gray-600 leading-relaxed">
                {activity.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Visit Types -->
  <section id="tipos-visita" class="py-20 lg:py-32 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Tipos de Visita
        </h2>
        <p class="text-xl text-gray-600">
          Elegí la experiencia que mejor se adapte a tu grupo
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 max-w-7xl mx-auto">
        {visitTypes.map((visit) => (
          <div class={`bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 ${visit.featured ? 'ring-4 ring-green-600' : ''}`}>
            {visit.featured && (
              <h4 class="bg-green-600 text-white text-center py-2 px-4 font-semibold text-sm flex items-center justify-center gap-2">
                <Star class="text-amber-400" />
                 Más Popular
              </h4>
            )}
            
            <div class="p-8">
              <div class="flex items-start justify-between mb-6">
                <div>
                  <h3 class="font-serif text-3xl font-bold text-gray-900 mb-2">
                    {visit.name}
                  </h3>
                  <div class="flex items-center gap-4 text-sm text-gray-600">
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      {visit.duration}
                    </span>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                      </svg>
                      {visit.groupSize}
                    </span>
                  </div>
                </div>
                <div class="text-right">
                  {visit.priceText ? (
                    <span class="text-3xl font-bold text-green-600">{visit.priceText}</span>
                  ) : (
                    <>
                      <span class="text-3xl font-bold text-green-600">${visit.price}</span>
                      <span class="block text-sm text-gray-500">por persona</span>
                    </>
                  )}
                </div>
              </div>

              <p class="text-gray-600 mb-6 leading-relaxed">
                {visit.description}
              </p>

              <div class="mb-6">
                <h4 class="font-semibold text-gray-900 mb-3">✓ Incluye:</h4>
                <ul class="space-y-2">
                  {visit.includes.map((item) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="bg-green-50 rounded-xl p-4 mb-6">
                <p class="text-sm text-green-900">
                  <strong>Ideal para:</strong> {visit.ideal}
                </p>
              </div>

              <a 
                href={`https://wa.me/5493884000000?text=Hola!%20Me%20interesa%20la%20${encodeURIComponent(visit.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center px-6 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-lg"
              >
                Reservar {visit.name}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Schedule -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Horarios de Visita
          </h2>
          <p class="text-xl text-gray-600">
            Trabajamos todos los días con reserva previa
          </p>
        </div>

        <div class="bg-cream-50 rounded-3xl overflow-hidden shadow-lg">
          <div class="divide-y divide-gray-200">
            {schedule.map((item) => (
              <div class="p-6 hover:bg-green-50 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <h3 class="font-semibold text-xl text-gray-900 mb-1">
                      {item.day}
                    </h3>
                    <p class="text-green-600 font-medium text-lg">
                      {item.hours}
                    </p>
                  </div>
                  <span class="text-sm text-gray-600 bg-white px-4 py-2 rounded-full">
                    {item.note}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-2xl p-6">
          <div class="flex items-start space-x-4">
            <svg class="w-6 h-6 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-yellow-900 mb-2">Importante</h4>
              <ul class="text-sm text-yellow-800 space-y-1">
                <li>• Todas las visitas requieren <strong>reserva previa</strong> (mínimo 7 días)</li>
                <li>• Para escuelas: coordinar con <strong>15-20 días de anticipación</strong></li>
                <li>• Llegá 15 minutos antes del horario agendado</li>
                <li>• En caso de mal tiempo, podemos reprogramar sin cargo</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 lg:py-32 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Lo Que Dicen Quienes Nos Visitaron
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {testimonials.map((testimonial) => (
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex items-center mb-4">
              {[...Array(testimonial.rating)].map((_, i) => (
                    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
              ))}
            </div>
            <p class="text-gray-600 mb-6 leading-relaxed italic">
              "{testimonial.text}"
            </p>
            <div class="flex items-center">
              <img 
                src={testimonial.image} 
                alt={testimonial.name}
                class="w-12 h-12 rounded-full mr-3 object-cover"
              />
              <div>
                <p class="font-semibold text-gray-900">{testimonial.name}</p>
                <p class="text-sm text-gray-500">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Preguntas Frecuentes
        </h2>
        <p class="text-xl text-gray-600">
          Todo lo que necesitás saber antes de visitarnos
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-4">
        {faqs.map((faq, index) => (
          <details class="group bg-cream-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <summary class="flex justify-between items-center p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-lg text-gray-900 pr-8">
                {faq.question}
              </h3>
              <svg class="w-6 h-6 text-green-600 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6">
              <p class="text-gray-600 leading-relaxed">
                {faq.answer}
