---
// src/pages/productos.astro
import Layout from '../layouts/Layout.astro';

// Importar datos desde JSON
import productsData from '../data/products.json';

const products = productsData.products;

// Generar categorías dinámicamente desde el JSON
const allCategories = [
  { id: 'todos', name: 'Todos los Productos', count: products.length }
];

// Agregar categorías del JSON
productsData.categories.forEach(cat => {
  const count = products.filter(p => p.category === cat.id).length;
  if (count > 0) {
    allCategories.push({
      id: cat.id,
      name: cat.name,
      count: count
    });
  }
});

const categories = allCategories;
---

<Layout 
  title="Productos - Granja Don Felipe | Huevos y Pollos Agroecológicos"
  description="Catálogo completo de productos de Granja Don Felipe. Huevos frescos, pollos de campo, gallinas ponedoras y verduras agroecológicas en San Salvador de Jujuy."
>
  
  <!-- Hero Section -->
  <section class="bg-cream-100 py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-4">
          Nuestro Catálogo
        </span>
        <h1 class="font-serif text-4xl lg:text-5xl xl:text-6xl font-bold text-gray-900 mb-6">
          Productos Frescos de la Granja
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Todo producido con amor y respeto por la naturaleza. Sin químicos, sin intermediarios, directo del campo a tu mesa.
        </p>
      </div>
    </div>
  </section>

  <!-- Filters & Products -->
  <section class="py-16 lg:py-20">
    <div class="container mx-auto px-4">
      
      <!-- Category Filters -->
      <div class="mb-12">
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map(category => (
            <button 
              data-category={category.id}
              class="category-filter px-6 py-3 rounded-lg font-medium transition-all duration-300 hover:scale-105"
              class:list={[
                category.id === 'todos' 
                  ? 'bg-green-600 text-white shadow-lg' 
                  : 'bg-white text-gray-700 hover:bg-green-50 hover:text-green-600 border border-gray-200'
              ]}
            >
              {category.name}
              <span class="ml-2 text-sm opacity-75">({category.count})</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Info Banner -->
      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 mb-12 max-w-4xl mx-auto">
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Precios orientativos - Consultá disponibilidad</h3>
            <p class="text-sm text-gray-600">
              Los precios pueden variar según temporada y disponibilidad. Te recomendamos consultar stock actualizado por WhatsApp antes de tu pedido.
            </p>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div id="products-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
          <div 
            class="product-card group bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
            data-category={product.category}
          >
            <!-- Image -->
            <div class="relative h-64 overflow-hidden">
              <img 
                src={product.image} 
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                transition:name={`${product.slug}-${product.id}`}
              />
              
              {/* Badges */}
              {product.badge && (
                <div class="absolute top-4 left-4 bg-green-600 text-white px-3 py-1 rounded-full text-sm font-medium">
                  {product.badge}
                </div>
              )}
              
              {!product.available && (
                <div class="absolute top-4 right-4 bg-gray-900 bg-opacity-90 text-white px-3 py-1 rounded-full text-sm font-medium">
                  Próximamente
                </div>
              )}

              {/* Category Tag */}
              <div class="absolute bottom-4 right-4 bg-white bg-opacity-95 px-3 py-1 rounded-full text-xs font-medium text-gray-700 capitalize">
                {product.category}
              </div>
            </div>

            <!-- Content -->
            <a href={`/Productos/${product.slug}`} class="p-6 block">
              <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2 flex items-center gap-2">
                {product.name} <span class="i-maki-arrow"></span>
              </h3>
              
              <p class="text-gray-600 mb-4 line-clamp-2">
                {product.description}
              </p>

              {/* Features */}
              <div class="flex flex-wrap gap-2 mb-4">
                {product.features.slice(0, 3).map(feature => (
                  <span class="inline-flex items-center text-xs text-green-700 bg-green-50 px-2 py-1 rounded-full">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {feature}
                  </span>
                ))}
              </div>

              {/* Price */}
              <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
                <div>
                  <span class="text-3xl font-bold text-gray-900">${product.price}</span>
                  <span class="text-sm text-gray-500 ml-1">ARS</span>
                </div>
              </div>

              {/* CTA Button */}
              {product.available ? (
                <a 
                  href={`https://wa.me/5493884000000?text=Hola!%20Me%20interesa%20${encodeURIComponent(product.name)}%20-%20¿Tienen%20disponibilidad?`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-lg"
                >
                  Consultar Disponibilidad
                </a>
              ) : (
                <button 
                  disabled
                  class="block w-full text-center px-6 py-3 bg-gray-200 text-gray-500 font-medium rounded-lg cursor-not-allowed"
                >
                  No Disponible
                </button>
              )}
            </a>
          </div>
        ))}
      </div>

      <!-- Empty State (hidden by default) -->
      <div id="empty-state" class="hidden text-center py-20">
        <svg class="w-24 h-24 text-gray-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">
          No hay productos en esta categoría
        </h3>
        <p class="text-gray-600">
          Probá con otra categoría o mirá todos los productos.
        </p>
      </div>
    </div>
  </section>

  <!-- Info Section -->
  <section class="py-16 lg:py-20 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-gray-900 mb-8 text-center">
          Información de Compra
        </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Delivery Info -->
          <div class="bg-white rounded-2xl p-8">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
              </svg>
            </div>
            <h3 class="font-serif text-xl font-bold text-gray-900 mb-3">
              Entregas y Retiros
            </h3>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Retiro en granja: Lunes a Sábados 9-18hs</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Delivery en San Salvador: Pedido mínimo $5.000</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Costo de envío: Consultá según zona</span>
              </li>
            </ul>
          </div>

          <!-- Payment Info -->
          <div class="bg-white rounded-2xl p-8">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            </div>
            <h3 class="font-serif text-xl font-bold text-gray-900 mb-3">
              Formas de Pago
            </h3>
            <ul class="space-y-2 text-gray-600">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Efectivo en el momento</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Transferencia bancaria</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>Mercado Pago</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact CTA -->
        <div class="mt-8 text-center bg-green-50 rounded-2xl p-8">
          <h3 class="font-serif text-2xl font-bold text-gray-900 mb-3">
            ¿Tenés dudas sobre algún producto?
          </h3>
          <p class="text-gray-600 mb-6">
            Escribinos por WhatsApp y te respondemos al instante
          </p>
          <a 
            href="https://wa.me/5493884000000?text=Hola!%20Tengo%20una%20consulta%20sobre%20los%20productos" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-xl"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Category Filter Functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.category-filter') as NodeListOf<HTMLButtonElement>;
    const productCards = document.querySelectorAll('.product-card') as NodeListOf<HTMLDivElement>;
    const emptyState = document.getElementById('empty-state') as HTMLDivElement;
    const productsGrid = document.getElementById('products-grid') as HTMLDivElement;

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');
        
        // Update active button
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-green-600', 'text-white', 'shadow-lg');
          btn.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });
        button.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        button.classList.add('bg-green-600', 'text-white', 'shadow-lg');

        

        // Filter products
        let visibleCount = 0;
        productCards.forEach(card => {
          const productCategory = card.getAttribute('data-category');
          
          if (category === 'todos' || productCategory === category) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Show/hide empty state
        if (visibleCount === 0) {
          productsGrid?.classList.add('hidden');
          emptyState?.classList.remove('hidden');
        } else {
          productsGrid?.classList.remove('hidden');
          emptyState?.classList.add('hidden');
        }

        // Smooth scroll to products
        productsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>