---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';

// Contact methods
const contactMethods = [
  {
    icon: 'whatsapp',
    title: 'WhatsApp',
    description: 'La forma más rápida de contactarnos',
    value: '+54 9 388 400-0000',
    link: 'https://wa.me/5493884000000',
    action: 'Escribinos',
    primary: true
  },
  {
    icon: 'phone',
    title: 'Teléfono',
    description: 'Llamanos en horario de atención',
    value: '(388) 400-0000',
    link: 'tel:+543884000000',
    action: 'Llamar',
    primary: false
  },
  {
    icon: 'email',
    title: 'Email',
    description: 'Respuesta en 24-48 horas',
    value: 'contacto@granjadonfelipe.com.ar',
    link: 'mailto:contacto@granjadonfelipe.com.ar',
    action: 'Enviar Email',
    primary: false
  }
];

// Office hours
const officeHours = [
  { day: 'Lunes a Viernes', hours: '9:00 - 18:00' },
  { day: 'Sábados', hours: '10:00 - 18:00' },
  { day: 'Domingos', hours: '10:00 - 16:00' },
  { day: 'Feriados', hours: 'Cerrado' }
];

// Delivery zones
const deliveryZones = [
  { zone: 'Centro', delivery: 'Sin cargo' },
  { zone: 'Alto Comedero', delivery: 'Sin cargo' },
  { zone: 'Pálpala', delivery: '$500' },
  { zone: 'Otras zonas', delivery: 'Consultar' }
];

// Social media
const socialMedia = [
  {
    name: 'Facebook',
    icon: 'facebook',
    url: 'https://facebook.com/GranjaDonFelipe',
    handle: '@GranjaDonFelipe'
  },
  {
    name: 'Instagram',
    icon: 'instagram',
    url: 'https://instagram.com/granjadonfelipe',
    handle: '@granjadonfelipe'
  },
  {
    name: 'TikTok',
    icon: 'tiktok',
    url: 'https://tiktok.com/@granjadonfelipe',
    handle: '@granjadonfelipe'
  }
];
---

<Layout 
  title="Contacto - Granja Don Felipe | Jujuy"
  description="Contactá a Granja Don Felipe en San Salvador de Jujuy. WhatsApp, teléfono, email, ubicación y horarios. Pedidos de productos y reservas de visitas."
>
  
  <!-- Hero Section -->
  <section class="bg-cream-100 py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-4">
          Contacto
        </span>
        <h1 class="font-serif text-4xl lg:text-5xl xl:text-6xl font-bold text-gray-900 mb-6">
          Hablemos
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Estamos acá para responder tus consultas sobre productos, visitas o lo que necesites. Elegí la forma que más te convenga.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto mb-16">
        {contactMethods.map((method) => (
          <a 
            href={method.link}
            target={method.icon === 'whatsapp' ? '_blank' : undefined}
            rel={method.icon === 'whatsapp' ? 'noopener noreferrer' : undefined}
            class={`group block bg-cream-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 ${method.primary ? 'ring-4 ring-green-600' : ''}`}
          >
            {method.primary && (
              <div class="bg-green-600 text-white text-center py-1 px-3 rounded-full text-xs font-semibold mb-4 inline-block">
                Recomendado
              </div>
            )}
            
            <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mb-6 transition-colors ${method.primary ? 'bg-green-600' : 'bg-white'} group-hover:bg-green-600`}>
              {method.icon === 'whatsapp' && (
                <svg class={`w-8 h-8 transition-colors ${method.primary ? 'text-white' : 'text-green-600'} group-hover:text-white`} fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              )}
              {method.icon === 'phone' && (
                <svg class={`w-8 h-8 transition-colors ${method.primary ? 'text-white' : 'text-green-600'} group-hover:text-white`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              )}
              {method.icon === 'email' && (
                <svg class={`w-8 h-8 transition-colors ${method.primary ? 'text-white' : 'text-green-600'} group-hover:text-white`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
            </div>

            <h3 class="font-serif text-2xl font-bold text-gray-900 mb-2">
              {method.title}
            </h3>
            <p class="text-gray-600 mb-4 text-sm">
              {method.description}
            </p>
            <p class="text-green-600 font-semibold mb-4">
              {method.value}
            </p>
            <span class="inline-flex items-center text-green-600 font-medium group-hover:translate-x-1 transition-transform">
              {method.action}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="py-16 lg:py-20 bg-cream-50">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 max-w-7xl mx-auto">
        
        <!-- Contact Form -->
        <div>
          <div class="mb-8">
            <h2 class="font-serif text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
              Envianos un Mensaje
            </h2>
            <p class="text-gray-600">
              Completá el formulario y te respondemos a la brevedad. También podés escribirnos directamente por WhatsApp para una respuesta más rápida.
            </p>
          </div>

          <form class="bg-white rounded-3xl p-8 shadow-lg space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                  Nombre *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-green-600 focus:ring-2 focus:ring-green-600 focus:ring-opacity-20 transition-colors"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                  Teléfono *
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-green-600 focus:ring-2 focus:ring-green-600 focus:ring-opacity-20 transition-colors"
                  placeholder="388 400-0000"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-green-600 focus:ring-2 focus:ring-green-600 focus:ring-opacity-20 transition-colors"
                placeholder="tu@email.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
                Asunto *
              </label>
              <select 
                id="subject" 
                name="subject"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-green-600 focus:ring-2 focus:ring-green-600 focus:ring-opacity-20 transition-colors"
              >
                <option value="">Seleccioná un motivo</option>
                <option value="productos">Consulta sobre productos</option>
                <option value="visitas">Reserva de visita</option>
                <option value="escuelas">Visita escolar</option>
                <option value="cumpleaños">Cumpleaños en la granja</option>
                <option value="delivery">Consulta sobre delivery</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                Mensaje *
              </label>
              <textarea 
                id="message" 
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-green-600 focus:ring-2 focus:ring-green-600 focus:ring-opacity-20 transition-colors resize-none"
                placeholder="Contanos qué necesitás..."
              ></textarea>
            </div>

            <div class="flex items-start">
              <input 
                type="checkbox" 
                id="privacy" 
                name="privacy"
                required
                class="mt-1 rounded text-green-600 focus:ring-green-600"
              />
              <label for="privacy" class="ml-3 text-sm text-gray-600">
                Acepto la <a href="/privacidad" class="text-green-600 hover:text-green-700 underline">política de privacidad</a> y autorizo el tratamiento de mis datos personales.
              </label>
            </div>

            <button 
              type="submit"
              class="w-full px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-all duration-300 hover:shadow-xl"
            >
              Enviar Mensaje
            </button>

            <p class="text-center text-sm text-gray-500">
              O escribinos directamente por <a href="https://wa.me/5493884000000" target="_blank" class="text-green-600 hover:text-green-700 font-medium">WhatsApp</a>
            </p>
          </form>
        </div>

        <!-- Info Sidebar -->
        <div class="space-y-8">
          
          <!-- Office Hours -->
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <h3 class="font-serif text-2xl font-bold text-gray-900">
                Horarios de Atención
              </h3>
            </div>
            <div class="space-y-3">
              {officeHours.map((item) => (
                <div class="flex justify-between items-center py-2 border-b border-gray-100 last:border-0">
                  <span class="text-gray-600">{item.day}</span>
                  <span class="font-semibold text-gray-900">{item.hours}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Delivery Zones -->
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                </svg>
              </div>
              <h3 class="font-serif text-2xl font-bold text-gray-900">
                Zonas de Entrega
              </h3>
            </div>
            <div class="space-y-3">
              {deliveryZones.map((item) => (
                <div class="flex justify-between items-center py-2 border-b border-gray-100 last:border-0">
                  <span class="text-gray-600">{item.zone}</span>
                  <span class={`font-semibold ${item.delivery === 'Sin cargo' ? 'text-green-600' : 'text-gray-900'}`}>
                    {item.delivery}
                  </span>
                </div>
              ))}
            </div>
            <p class="text-sm text-gray-500 mt-4">
              Pedido mínimo para delivery: $5.000
            </p>
          </div>

          <!-- Social Media -->
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
                </svg>
              </div>
              <h3 class="font-serif text-2xl font-bold text-gray-900">
                Seguinos
              </h3>
            </div>
            <div class="space-y-4">
              {socialMedia.map((social) => (
                <a 
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-4 bg-cream-50 rounded-xl hover:bg-green-50 transition-colors group"
                >
                  <div class="flex items-center">
                    {social.icon === 'facebook' && (
                      <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                      </div>
                    )}
                    {social.icon === 'instagram' && (
                      <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-500 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                      </div>
                    )}
                    {social.icon === 'tiktok' && (
                      <div class="w-10 h-10 bg-black rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
                        </svg>
                      </div>
                    )}
                    <div>
                      <p class="font-semibold text-gray-900">{social.name}</p>
                      <p class="text-sm text-gray-600">{social.handle}</p>
                    </div>
                  </div>
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-green-600 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-serif text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Cómo Llegar
          </h2>
          <p class="text-xl text-gray-600">
            Estamos en San Salvador de Jujuy, a minutos del centro
          </p>
        </div>

        <div class="bg-cream-50 rounded-3xl overflow-hidden shadow-2xl">
          <div class="grid lg:grid-cols-5">
            <!-- Map -->
            <div class="lg:col-span-3 h-[500px] relative">
              <!-- Google Maps embed placeholder -->
              <div class="w-full h-full bg-gray-300 relative">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3650.9!2d-65.3!3d-24.2!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDEyJzAwLjAiUyA2NcKwMTgnMDAuMCJX!5e0!3m2!1ses!2sar!4v1234567890"
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Ubicación Granja Don Felipe"
                ></iframe>
              </div>
            </div>

            <!-- Location Info -->
            <div class="lg:col-span-2 p-8 lg:p-12 bg-white">
              <h3 class="font-serif text-2xl font-bold text-gray-900 mb-6">
                Granja Don Felipe
              </h3>

              <div class="space-y-6">
                <div class="flex items-start">
                  <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 mb-1">Dirección</p>
                    <p class="text-gray-600">
                      San Salvador de Jujuy<br/>
                      Provincia de Jujuy<br/>
                      Argentina
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                    </svg>
                  </div>
                  <div>
